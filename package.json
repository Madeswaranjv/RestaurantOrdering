{
  "name": "flavordash-desktop",
  "version": "1.0.0",
  "description": "FlavorDash desktop application",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n API,UI,DESKTOP -c yellow,cyan,magenta \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\" \"cross-env-shell \\\"FLAVORDASH_BACKEND_EXTERNAL=1 wait-on http-get://localhost:5173 && electron .\\\"\"",
    "build:renderer": "npm --prefix frontend run build",
    "build": "npm run build:renderer && electron-builder",
    "dist": "npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.flavordash.desktop",
    "productName": "FlavorDash",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.env",
          "!node_modules{,/**/*}",
          "!node_modules/.cache/**/*"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!.cache/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
